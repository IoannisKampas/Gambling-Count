[Unit]
Description=Virtual X display :99 (the monitor's browser runs headed on it)
After=network.target

[Service]
User=bj
Group=bj
# -nolisten tcp: the display is reachable only through its unix socket in /tmp/.X11-unix
ExecStart=/usr/bin/Xvfb :99 -screen 0 1920x1080x24 -nolisten tcp
Restart=always
RestartSec=2

# NOTE: no PrivateTmp here, and none in blackjack-monitor.service either. The X socket
# lives in /tmp/.X11-unix, so a private /tmp would hide this display from the very
# process that needs it, and Chrome would fail with "cannot open display :99".

[Install]
WantedBy=multi-user.target
